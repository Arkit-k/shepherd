{
  "name": "@arkit/shepherd",
  "version": "0.1.0",
  "description": "Connect running Claude Code sessions to a shared board — each one sees what you type in the others. Plus a production-readiness audit for AI-written code.",
  "type": "module",
  "bin": {
    "shepherd": "dist/cli.js",
    "shepherd-mcp": "dist/mcp.js",
    "shepherd-hook": "dist/hook.js",
    "shepherd-session": "dist/session.js",
    "shepherd-connect": "dist/connect.js",
    "shepherd-setup": "dist/setup.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "mcp": "tsx src/mcp.ts",
    "app": "tsx src/app/server.ts",
    "start:app": "node dist/app/server.js",
    "build": "tsc",
    "start": "node dist/cli.js",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test",
    "release": "node scripts/publish.mjs",
    "release:dry": "node scripts/publish.mjs --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@octokit/webhooks": "^14.2.0",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "octokit": "^5.0.5",
    "picocolors": "^1.1.0",
    "ts-morph": "^23.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "author": "Arkit Karmokar",
  "homepage": "https://github.com/Arkit-k/shepherd#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arkit-k/shepherd.git"
  },
  "bugs": {
    "url": "https://github.com/Arkit-k/shepherd/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "mcp",
    "multi-agent",
    "agents",
    "ai",
    "code-review",
    "cli"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "scripts",
    "dist",
    "docs",
    "packs",
    "scan",
    "soul.md",
    "user.md",
    "README.md",
    "LICENSE"
  ]
}
